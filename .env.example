# Copia este archivo a .env y completa los valores de tu proyecto Supabase.
# El servidor los inyecta en el index.html al arrancar.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# MongoDB Atlas o una instancia local. Sin URI, el proyecto usa datos demo en memoria.
MONGODB_URI=
# Opcional: nombre de la base de datos (si no se define, se usa el nombre de la URI).
MONGODB_DB=luxars
